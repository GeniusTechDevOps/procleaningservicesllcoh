---
import type { RootObject, SectionsHomeAbout } from "../interfaces/dbData.ts";
import Layout from "../layouts/Layout.astro";
import TransparentHeader from "../components/global/TransparentHeader.astro";
import AboutSectionOne from "../components/about/AboutSectionOne.tsx";
import AboutSectionTwo from "../components/about/AboutSectionTwo.tsx";
import Values from "../components/about/Values.tsx";
import { getAppDataDirect } from "../utils/api";

// Realiza la llamada a la API (o carga datos locales si API_URL está vacía)
const data: RootObject = await getAppDataDirect();

//filtrar para obtener la section de home
const dataBlocks = data?.sectionsHomeAbout.filter(
    (section: SectionsHomeAbout) => section.section === "blocks",
);
//filtrar para obtener la section de about
const aboutSection = data?.sectionsHomeAbout.filter(
    (section: SectionsHomeAbout) => section.section === "about",
);
---

<Layout
    title={`Home | ${data.name}`}
    description={dataBlocks[1].text}
    favicon={data.logos.primary}
    featuredImage={data.logos.favicon}
    keywords={data.services.map((service) => service.title).join(", ")}
>
    <TransparentHeader
        title="About Us"
        image={dataBlocks[0].additionalImages[0]}
    />

    <AboutSectionOne
        data={data}
        aboutSection={aboutSection}
        client:only="react"
    />
    <Values data={data} client:only="react" />
    <AboutSectionTwo
        data={data}
        aboutSection={aboutSection}
        client:only="react"
    />
</Layout>
