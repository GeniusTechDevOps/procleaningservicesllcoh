---
export const prerender = false;

import TransparentHeader from "../../components/global/TransparentHeader.astro";
import type { RootObject } from "../../interfaces/dbData";
import Layout from "../../layouts/Layout.astro";

import { fetchAppData, fetchPublicGeoPage } from "../../utils/api";
import { findGeoPageBySlug, normalizeGeoPages } from "../../utils/geo";

const { slug } = Astro.params;

const siteResult = await fetchAppData();
if (!siteResult.ok) {
  console.error("Error fetching app data (resource detail):", siteResult.error);
  return new Response(null, { status: 500 });
}

const data: RootObject = siteResult.data;

const geoResult = await fetchPublicGeoPage();
if (!geoResult.ok) {
  console.error("Error fetching geo resource detail:", geoResult.error);
  return new Response(null, { status: 500 });
}

const pages = normalizeGeoPages(geoResult.data).filter(
  (page) => page.status === "published",
);
const currentPage = findGeoPageBySlug(pages, slug);

if (!currentPage) {
  return new Response(null, { status: 404 });
}

const title = currentPage.title;
const description = currentPage.description;
const keywords = currentPage.keywords.join(", ");
const proofs = currentPage.proofs;
const sections = currentPage.sections ?? [];
const faqs = currentPage.faqs ?? [];
const contractor = currentPage.contractor;
const service = currentPage.service;
const location = currentPage.location;
const cta = currentPage.content?.cta;
const schemaItems = Array.isArray(currentPage.schema)
  ? currentPage.schema.filter((item) => item?.jsonLd)
  : [];
const aiPlatforms = [
  {
    name: "ChatGPT",
    icon: "https://upload.wikimedia.org/wikipedia/commons/e/ef/ChatGPT-Logo.svg",
    shell: "from-emerald-500 to-teal-600",
  },
  {
    name: "Gemini",
    icon: "https://cdn.simpleicons.org/googlegemini/FFFFFF",
    shell: "from-sky-500 to-indigo-600",
  },
  {
    name: "Grok",
    icon: "https://upload.wikimedia.org/wikipedia/commons/f/f4/Grok_logo_without_text.svg",
    shell: "from-black to-black",
  },
  {
    name: "Claude",
    icon: "https://cdn.simpleicons.org/anthropic/FFFFFF",
    shell: "from-orange-400 to-amber-600",
  },
  {
    name: "Perplexity",
    icon: "https://cdn.simpleicons.org/perplexity/FFFFFF",
    shell: "from-cyan-500 to-sky-700",
  },
  {
    name: "Copilot",
    icon: "https://cdn.simpleicons.org/githubcopilot/FFFFFF",
    shell: "from-violet-500 to-blue-600",
  },
];
const audience = [
  service?.residential ? "Residential" : "",
  service?.commercial ? "Commercial" : "",
]
  .filter(Boolean)
  .join(" & ");
const trustBadges = [
  contractor?.licensed ? "Licensed" : "",
  contractor?.insured ? "Insured" : "",
  contractor?.bonded ? "Bonded" : "",
  contractor?.freeEstimates ? "Free Estimates" : "",
  contractor?.emergencyService ? "Emergency Service" : "",
].filter(Boolean);
const certifications = currentPage.trust?.certifications ?? [];
const warranties = currentPage.trust?.warranties ?? [];
const reviewHighlights = currentPage.trust?.reviewHighlights ?? [];
const ratingValue = contractor?.rating
  ? Number(contractor.rating).toFixed(1)
  : "";
const reviewCount = contractor?.reviewCount || 0;

const publishedDate = currentPage.publishedAt
  ? new Date(currentPage.publishedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";

const updatedDate = currentPage.updatedAt
  ? new Date(currentPage.updatedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";

const phone = String(
  cta?.phone ||
    contractor?.phone ||
    data?.dataGeneral?.phones?.[0]?.number ||
    "",
).trim();
const phoneHref = phone ? `tel:${phone.replace(/[^0-9+]/g, "")}` : "";

const platformIconTheme = (name: string) => {
  if (name === "ChatGPT") return "background:#10b981;color:white;";
  if (name === "Gemini") return "background:#2563eb;color:white;";
  if (name === "Grok") return "background:#111827;color:white;";
  if (name === "Claude") return "background:#f97316;color:white;";
  if (name === "Perplexity") return "background:#06b6d4;color:white;";
  if (name === "Copilot") return "background:#8b5cf6;color:white;";
  return "background:#525252;color:white;";
};

const platformPillTheme = (name: string) => {
  if (name === "ChatGPT") return "background:#10b981;color:white;";
  if (name === "Gemini") return "background:#2563eb;color:white;";
  if (name === "Grok") return "background:#111827;color:white;";
  if (name === "Claude") return "background:#f97316;color:white;";
  if (name === "Perplexity") return "background:#06b6d4;color:white;";
  if (name === "Copilot") return "background:#8b5cf6;color:white;";
  return "background:#525252;color:white;";
};
---

<Layout
  title={currentPage.seo?.metaTitle || currentPage.seo?.title || title}
  description={description}
  favicon={data.logos?.primary ?? ""}
  keywords={keywords}
  featuredImage={data.logos?.primary ?? ""}
  canonical={currentPage.canonical}
>
  {
    schemaItems.map((item) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(item.jsonLd)}
      />
    ))
  }

  <TransparentHeader
    title={currentPage.seo?.h1 || title}
    image={data.gallery?.[2] ?? data.logos?.primary ?? ""}
  />

  <section class="max-w-7xl mx-auto px-4 py-8 sm:px-6 sm:py-10">
    <div class="overflow-hidden rounded-[2.5rem] border border-black/10">
      <div class="grid gap-0 lg:grid-cols-[1.2fr_0.8fr]">
        <div
          class="relative overflow-hidden border-b border-black p-6 sm:p-8 lg:border-b-0 lg:border-r"
        >
          <div class="relative">
            <div class="flex flex-wrap items-center gap-2">
              <span
                class="inline-flex items-center rounded-full border px-4 py-2 text-[11px] font-black uppercase tracking-[0.22em] text-black"
                style={{
                  background:
                    "color-mix(in srgb, var(--primary) 10%, white 90%)",
                  borderColor:
                    "color-mix(in srgb, var(--primary) 22%, transparent)",
                }}
              >
                <i class="fa-solid fa-book-open mr-2" aria-hidden="true"></i>
                Resource Guide
              </span>
              {
                location?.city && (
                  <span class="inline-flex items-center rounded-full border border-black/10 bg-secondary px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-white">
                    <i
                      class="fa-solid fa-location-dot mr-2 text-white"
                      aria-hidden="true"
                    />
                    {location.city}, {location.stateCode || location.state}
                  </span>
                )
              }
              {
                service?.name && (
                  <span class="inline-flex items-center rounded-full border border-black/10 bg-secondary px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-white">
                    <i
                      class="fa-solid fa-screwdriver-wrench mr-2 text-white"
                      aria-hidden="true"
                    />
                    {service.name}
                  </span>
                )
              }
            </div>

            <h1
              class="mt-6 max-w-5xl text-3xl font-black tracking-[-0.04em] sm:text-5xl lg:text-6xl text-primary"
            >
              {currentPage.seo?.h1 || title}
            </h1>

            {
              currentPage.content?.summary && (
                <p class="mt-5 max-w-3xl text-base leading-8 text-text/84 sm:text-lg">
                  {currentPage.content.summary}
                </p>
              )
            }

            <div class="mt-6 grid gap-4 xl:grid-cols-[0.9fr_1.1fr]">
              <div
                class="rounded-[1.9rem] border border-black/10 bg-white p-5 shadow-[0_18px_40px_rgba(15,23,42,0.04)]"
              >
                <p
                  class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500"
                >
                  Resource details
                </p>
                <div class="mt-4 grid grid-cols-1 gap-3">
                  <div
                    class="rounded-[1.35rem] border border-black/5 bg-slate-50 px-4 py-4"
                  >
                    <p
                      class="text-[11px] uppercase tracking-[0.16em] text-secondary"
                    >
                      Service
                    </p>
                    <p class="mt-2 text-base font-black text-slate-900">
                      {service?.name || "Service Resource"}
                    </p>
                  </div>
                  <div
                    class="rounded-[1.35rem] border border-black/5 bg-slate-50 px-4 py-4"
                  >
                    <p
                      class="text-[11px] uppercase tracking-[0.16em] text-secondary"
                    >
                      Audience
                    </p>
                    <p class="mt-2 text-base font-black text-slate-900">
                      {audience || "General"}
                    </p>
                  </div>
                  <div
                    class="rounded-[1.35rem] border border-black/5 bg-slate-50 px-4 py-4"
                  >
                    <p
                      class="text-[11px] uppercase tracking-[0.16em] text-secondary"
                    >
                      Published
                    </p>
                    <p class="mt-2 text-base font-black text-slate-900">
                      {publishedDate || "Available now"}
                    </p>
                  </div>
                  <div
                    class="rounded-[1.35rem] border border-black/5 bg-slate-50 px-4 py-4"
                  >
                    <p
                      class="text-[11px] uppercase tracking-[0.16em] text-secondary"
                    >
                      Updated
                    </p>
                    <p class="mt-2 text-base font-black text-slate-900">
                      {updatedDate || publishedDate || "Recently"}
                    </p>
                  </div>
                </div>
              </div>

              <div class="grid gap-4">
                {
                  phoneHref && (
                    <div class="rounded-[1.9rem] p-5 text-slate-900 shadow-[0_18px_40px_rgba(15,23,42,0.06)] bg-white border border-black/10">
                      <p class="text-[11px] font-black uppercase tracking-[0.2em] text-slate-500">
                        Direct contact
                      </p>
                      <div class="mt-4 grid gap-4">
                        <div class="rounded-[1.35rem] border border-primary/20 bg-primary/5 px-4 py-4">
                          <p class="text-sm font-semibold text-slate-600">
                            Call now
                          </p>
                          <a
                            href={phoneHref}
                            class="mt-1 inline-flex text-3xl font-black tracking-tight text-slate-900 transition hover:text-primary sm:text-4xl"
                          >
                            {phone}
                          </a>
                        </div>
                        <div>
                          <a
                            href={phoneHref}
                            class="inline-flex w-full items-center justify-center gap-3 rounded-[1.2rem] bg-primary px-5 py-4 text-sm font-black text-white shadow-lg transition hover:-translate-y-0.5"
                          >
                            <i
                              class="fa-solid fa-phone-volume text-white"
                              aria-hidden="true"
                            />
                            {cta?.buttonText || "Call now"}
                          </a>
                        </div>
                      </div>
                    </div>
                  )
                }

                <div
                  class="rounded-[1.9rem] border border-black/10 bg-white p-5 shadow-[0_18px_40px_rgba(15,23,42,0.04)]"
                >
                  <div class="flex items-center justify-between gap-3">
                    <div>
                      <p
                        class="text-[11px] font-black uppercase tracking-[0.18em] text-slate-500"
                      >
                        AI distribution
                      </p>
                      <p class="mt-1 text-sm leading-6 text-slate-600">
                        Structured for discovery across assistant-style search
                        experiences.
                      </p>
                    </div>
                    <span
                      class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-primary/10 text-primary"
                    >
                      <i class="fa-solid fa-robot" aria-hidden="true"></i>
                    </span>
                  </div>
                  <div class="mt-6 flex items-center py-1">
                    {
                      aiPlatforms.map((platform, index) => (
                        <div
                          class="group relative shrink-0"
                          style={{
                            marginLeft: index === 0 ? "0" : "-1.45rem",
                            zIndex: String(aiPlatforms.length - index),
                          }}
                        >
                          <div class="flex h-14 w-14 items-center overflow-visible rounded-full border-4 border-white bg-white">
                            <span
                              class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-full p-3 cursor-pointer"
                              style={platformIconTheme(platform.name)}
                            >
                              <img
                                src={platform.icon}
                                alt={`${platform.name} logo`}
                                class="h-6 w-6 object-contain"
                                loading="lazy"
                                decoding="async"
                              />
                            </span>
                          </div>
                          <span
                            class="pointer-events-none absolute left-1/2 top-full z-20 mt-2 -translate-x-1/2 whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-bold leading-none text-white opacity-0 transition-opacity duration-200 ease-out group-hover:opacity-100"
                            style={platformPillTheme(platform.name)}
                          >
                            {platform.name}
                          </span>
                        </div>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid content-start gap-4 bg-slate-50/50 p-6 sm:p-8">
          <section
            class="rounded-[1.9rem] border border-black/10 bg-white p-5 shadow-sm"
          >
            <p class="text-xs uppercase tracking-[0.18em] text-slate-500">
              Resource snapshot
            </p>
            <h2 class="mt-3 text-2xl font-black text-primary">
              Built for trust and discovery
            </h2>
            <dl class="mt-5 space-y-4 text-sm">
              <div class="flex items-start justify-between gap-4">
                <dt class="text-slate-600">Contractor</dt>
                <dd class="text-right font-semibold text-slate-900">
                  {contractor?.name || data.name}
                </dd>
              </div>
              <div class="flex items-start justify-between gap-4">
                <dt class="text-slate-600">Category</dt>
                <dd class="text-right font-semibold text-slate-900">
                  {service?.category || "Local Service"}
                </dd>
              </div>
              <div class="flex items-start justify-between gap-4">
                <dt class="text-slate-600">Coverage</dt>
                <dd class="text-right font-semibold text-slate-900">
                  {location?.city}, {location?.stateCode || location?.state}
                </dd>
              </div>
              <div class="flex items-start justify-between gap-4">
                <dt class="text-slate-600">Indexing</dt>
                <dd class="text-right font-semibold text-slate-900">
                  AI-ready structure
                </dd>
              </div>
            </dl>
          </section>

          <section
            class="rounded-[1.9rem] border p-5 shadow-sm bg-white"
            style={{
              borderColor:
                "color-mix(in srgb, var(--primary) 16%, transparent)",
            }}
          >
            <p class="text-xs uppercase tracking-[0.18em] text-slate-500">
              Positioning note
            </p>
            <p class="mt-3 text-sm leading-7 text-slate-600">
              This page is structured to surface service intent, local context,
              proof points, and direct response actions in the first screenful.
            </p>
            {
              proofs.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {proofs.slice(0, 3).map((proof) => (
                    <span class="inline-flex items-center rounded-full border border-black/10 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-900">
                      <i
                        class="fa-solid fa-check mr-2 text-[10px] text-primary"
                        aria-hidden="true"
                      />
                      {proof}
                    </span>
                  ))}
                </div>
              )
            }
          </section>
        </div>
      </div>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-12">
      <main class="space-y-6 lg:col-span-8">
        {
          currentPage.content?.intro && (
            <section class="rounded-[2rem] border border-black/10 bg-white p-6 md:p-8 ring-1 ring-black/5 shadow-[0_18px_48px_rgba(15,23,42,0.04)]">
              <div class="grid gap-6 md:grid-cols-[auto_1fr] md:items-start">
                <div
                  class="inline-flex h-14 w-14 items-center justify-center rounded-[1.25rem] text-white shadow-sm"
                  style={{ background: "var(--primary)" }}
                >
                  <i class="fa-solid fa-layer-group" aria-hidden="true" />
                </div>
                <div>
                  <p class="text-xs uppercase tracking-[0.18em] text-slate-500">
                    Overview
                  </p>
                  <h2 class="mt-2 text-2xl font-black text-primary">
                    What this resource covers
                  </h2>
                  <p class="mt-4 whitespace-pre-line text-base leading-8 text-slate-700">
                    {currentPage.content.intro}
                  </p>
                </div>
              </div>
            </section>
          )
        }

        {
          sections.length > 0 && (
            <section class="rounded-[2rem] border border-black/10 bg-white p-6 md:p-8 ring-1 ring-black/5 shadow-[0_18px_48px_rgba(15,23,42,0.04)]">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <p class="text-xs uppercase tracking-[0.18em] text-slate-500">
                    Detailed content
                  </p>
                  <h2 class="mt-2 text-2xl font-black text-primary">
                    Service and location breakdown
                  </h2>
                </div>
                <span class="inline-flex items-center rounded-full border border-black/10 bg-slate-50 px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-slate-600">
                  {sections.length} sections
                </span>
              </div>
              <div class="mt-6 space-y-4">
                {sections.map((section, index) => (
                  <article class="grid gap-4 rounded-[1.75rem] border border-black/5 bg-slate-50 p-5 md:grid-cols-[auto_1fr] md:p-6">
                    <div
                      class="inline-flex h-12 w-12 items-center justify-center rounded-2xl text-sm font-black text-white shadow-sm"
                      style={{
                        background:
                          index % 2 === 0
                            ? "var(--primary)"
                            : "var(--btn-color)",
                      }}
                    >
                      {(index + 1).toString().padStart(2, "0")}
                    </div>
                    <div>
                      <h2 class="text-2xl font-black text-secondary">
                        {section?.title}
                      </h2>
                      <p class="mt-4 whitespace-pre-line text-base leading-8 text-slate-700">
                        {section?.body}
                      </p>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )
        }

        {
          faqs.length > 0 && (
            <section class="rounded-[2rem] border border-black/10 bg-white p-6 md:p-8 ring-1 ring-black/5 shadow-[0_18px_48px_rgba(15,23,42,0.04)]">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <p class="text-xs uppercase tracking-[0.18em] text-slate-500">
                    FAQ
                  </p>
                  <h2 class="mt-2 text-2xl font-black text-primary">
                    Frequently Asked Questions
                  </h2>
                </div>
                <span class="inline-flex items-center rounded-full border border-black/10 bg-slate-50 px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-slate-600">
                  {faqs.length} answers
                </span>
              </div>
              <div class="mt-6 grid grid-cols-1 gap-4">
                {faqs.map((faq) => (
                  <article class="rounded-[1.5rem] border border-black/5 bg-slate-50 p-5 shadow-sm">
                    <div class="flex items-start gap-4">
                      <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                        <i
                          class="fa-solid fa-circle-question"
                          aria-hidden="true"
                        />
                      </span>
                      <div>
                        <h3 class="text-lg font-bold text-slate-900">
                          {faq?.question}
                        </h3>
                        <p class="mt-3 text-base leading-7 text-slate-700">
                          {faq?.answer}
                        </p>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )
        }
      </main>

      <aside class="lg:col-span-4">
        <div class="space-y-4 lg:sticky lg:top-6">
          <section
            class="rounded-[2rem] border border-black/10 bg-white p-6 ring-1 ring-black/5 shadow-[0_18px_48px_rgba(15,23,42,0.04)]"
          >
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xl font-black text-primary">Resource Snapshot</h3>
              <span
                class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-primary/10 text-primary"
              >
                <i class="fa-solid fa-chart-column" aria-hidden="true"></i>
              </span>
            </div>
            <dl class="mt-5 space-y-4 text-sm">
              <div class="flex items-start justify-between gap-4">
                <dt class="text-slate-600">Contractor</dt>
                <dd class="text-right font-semibold text-slate-900">
                  {contractor?.name || data.name}
                </dd>
              </div>
              <div class="flex items-start justify-between gap-4">
                <dt class="text-slate-600">Category</dt>
                <dd class="text-right font-semibold text-slate-900">
                  {service?.category || "Local Service"}
                </dd>
              </div>
              <div class="flex items-start justify-between gap-4">
                <dt class="text-slate-600">Coverage</dt>
                <dd class="text-right font-semibold text-slate-900">
                  {location?.city}, {location?.stateCode || location?.state}
                </dd>
              </div>
              <div class="flex items-start justify-between gap-4">
                <dt class="text-slate-600">Audience</dt>
                <dd class="text-right font-semibold text-slate-900">
                  {audience || "General"}
                </dd>
              </div>
            </dl>

            {
              (ratingValue || trustBadges.length > 0) && (
                <div class="mt-5 rounded-[1.5rem] border border-black/10 bg-slate-50 p-4">
                  <div>
                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">
                      Rating
                    </p>
                    <p class="mt-1 text-2xl font-black text-title">
                      {ratingValue}
                    </p>
                  </div>
                  {ratingValue && (
                    <div class="flex items-center justify-between gap-3">
                      <div>
                        <p class="text-xs uppercase tracking-[0.18em] text-slate-500">
                          Rating
                        </p>
                        <p class="mt-1 text-2xl font-black text-title">
                          {ratingValue}
                        </p>
                      </div>
                      <p class="text-right text-sm leading-6 text-slate-600">
                        {reviewCount > 0
                          ? `${reviewCount}+ reviews`
                          : "Verified trust signal"}
                      </p>
                    </div>
                  )}
                  {trustBadges.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {trustBadges.map((badge) => (
                        <span class="inline-flex items-center rounded-full border border-primary/15 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                          {badge}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              )
            }
          </section>

          {
            proofs.length > 0 && (
              <section class="rounded-[2rem] border border-black/10 bg-white p-6 ring-1 ring-black/5 shadow-[0_18px_48px_rgba(15,23,42,0.04)]">
                <h3 class="text-xl font-black text-primary">
                  Why Clients Trust This Service
                </h3>
                <div class="mt-5 space-y-3">
                  {proofs.map((proof) => (
                    <div class="flex gap-3 rounded-2xl border border-black/5 bg-slate-50 p-4">
                      <span class="mt-1 inline-flex h-6 w-6 items-center justify-center rounded-full bg-primary/10 text-primary">
                        <i
                          class="fa-solid fa-check text-xs"
                          aria-hidden="true"
                        />
                      </span>
                      <p class="text-sm leading-7 text-slate-700">{proof}</p>
                    </div>
                  ))}
                </div>
              </section>
            )
          }

          {
            (certifications.length > 0 ||
              warranties.length > 0 ||
              reviewHighlights.length > 0) && (
              <section class="rounded-[2rem] border border-black/10 bg-white p-6 ring-1 ring-black/5 shadow-[0_18px_48px_rgba(15,23,42,0.04)]">
                <h3 class="text-xl font-black text-primary">Trust Layer</h3>

                {certifications.length > 0 && (
                  <div class="mt-5">
                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">
                      Certifications
                    </p>
                    <div class="mt-3 flex flex-wrap gap-2">
                      {certifications.map((item) => (
                        <span class="inline-flex items-center rounded-full border border-black/10 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-900">
                          <i
                            class="fa-solid fa-certificate mr-2 text-primary"
                            aria-hidden="true"
                          />
                          {item}
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                {warranties.length > 0 && (
                  <div class="mt-5">
                    <p class="text-xs uppercase tracking-[0.18em] text-slate-500">
                      Warranties
                    </p>
                    <div class="mt-3 flex flex-wrap gap-2">
                      {warranties.map((item) => (
                        <span class="inline-flex items-center rounded-full border border-black/10 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-900">
                          <i
                            class="fa-solid fa-shield-halved mr-2 text-primary"
                            aria-hidden="true"
                          />
                          {item}
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                {/* {reviewHighlights.length > 0 && (
                <div class="mt-5 space-y-3">
                  <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Review Highlights</p>
                  {reviewHighlights.map((highlight) => (
                    <article class="rounded-[1.5rem] border border-black/8 bg-slate-50 p-4">
                      <div class="flex items-center justify-between gap-3">
                        <p class="font-semibold text-title">{highlight.author || "Verified client"}</p>
                        {highlight.rating && (
                          <span class="inline-flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">
                            <i class="fa-solid fa-star text-[10px]" aria-hidden="true" />
                            {highlight.rating.toFixed(1)}
                          </span>
                        )}
                      </div>
                      {highlight.text && (
                        <p class="mt-3 text-sm leading-7 text-slate-700">{highlight.text}</p>
                      )}
                    </article>
                  ))}
                </div>
              )} */}
              </section>
            )
          }

          <section
            class="overflow-hidden rounded-[2rem] border border-black/10 shadow-[0_20px_60px_rgba(15,23,42,0.12)]"
          >
            <div class="p-6 text-white" style={{ background: "var(--title)" }}>
              <p class="text-xs uppercase tracking-[0.22em] text-white/72">
                Next Step
              </p>
              <h3 class="mt-3 text-2xl font-black text-white">
                {cta?.title || "Request your estimate"}
              </h3>
              <p class="mt-3 text-sm leading-7 text-white/84">
                {
                  cta?.description ||
                    "Contact our team for project guidance, pricing, and scheduling details."
                }
              </p>
            </div>
            <div class="bg-slate-50 p-6">
              <div class="space-y-3">
                {
                  phoneHref && (
                    <a
                      href={phoneHref}
                      class="inline-flex w-full items-center justify-center gap-2 rounded-2xl px-4 py-3 text-sm font-bold text-white shadow-lg transition hover:-translate-y-0.5"
                      style={{ background: "var(--primary)" }}
                    >
                      <i class="fa-solid fa-phone" aria-hidden="true" />
                      {cta?.buttonText || "Call now"}: {phone}
                    </a>
                  )
                }

                <a
                  href="/resources"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-2xl border border-black/10 bg-white px-4 py-3 text-sm font-semibold text-title shadow-sm transition hover:bg-neutral-50"
                >
                  <i
                    class="fa-solid fa-arrow-left text-primary"
                    aria-hidden="true"></i>
                  Back to Resources
                </a>
              </div>
            </div>
          </section>
        </div>
      </aside>
    </div>
  </section>
</Layout>
