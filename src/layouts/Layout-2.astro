---
import "../styles/global.css";
import type { RootObject } from "../interfaces/dbData.ts";
import Header from "../components/global/header/Header.astro";
import Footer from "../components/global/footer/Footer.astro";
import ScrollToTop from "../components/global/widgets/ScrollToTop.tsx";
import AccessibilityPanel from "../components/global/widgets/AccessibilityPanel.tsx";
import SiteDown from "../components/global/widgets/SiteDown.astro";
import UnderConstruction from "../components/global/widgets/UnderConstruction.astro";
import WidgetButton from "../components/global/widgets/ContentWidgets.tsx";
import { buildBaseStructuredData, getSiteOrigin } from "../lib/aiDiscovery";
import { getAppDataDirect } from "../utils/api";

interface Props {
  title: string;
  description: string;
  keywords: string;
  featuredImage: string;
  favicon: string;
  canonical?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  keywords,
  featuredImage,
  favicon,
  canonical,
  structuredData,
} = Astro.props;

let API_URL = import.meta.env.API_URL;
// Realiza la llamada a la API
const response = await fetch(`${API_URL}`);
const data: RootObject = await response.json();
const enableDarkMode = data.widgets.popup;
const { url } = Astro.request;
const domain = new URL(url).origin;
const isLocalhost = domain.includes("localhost");
const isSubdomainVercel = domain.includes("vercel.app");
const isSubdomainNetlify = domain.includes("netlify.app");
const siteOrigin = data ? getSiteOrigin(data, url) : "";
const baseStructuredData = data
  ? buildBaseStructuredData(data, siteOrigin)
  : [];
const pageStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const allStructuredData = [...baseStructuredData, ...pageStructuredData];
---

<!doctype html>
<html lang="en" transition:animate="slide">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="keywords" content={keywords} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={featuredImage} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={featuredImage} />

    <link href="../assets/css/styles.css" rel="stylesheet" />
    <link href="../assets/css/button.css" rel="stylesheet" />
    <link
      href="https://cdn.jsdelivr.net/gh/Andres179012/reacktor-fonts/style.css"
      rel="stylesheet"
    />
  </head>
  <body
    style={data
      ? {
          "--btn-border-color": data.colors.btnHoverColor,
          "--btn-hover-color": data.colors.btnHoverColor,
          "--primary": data.colors.primaryColor,
          "--secondary": data.colors.secondaryColor,
          "--tertiary": data.colors.tertiaryColor,
          "--fourth": data.colors.fourthColor,
          "--title": data.colors.titleColor,
          "--text": data.colors.textColor,
          "--btn-color": data.colors.btnColor,
        }
      : undefined}
  >
    {
      !isLocalhost &&
      !isSubdomainVercel &&
      !isSubdomainNetlify &&
      data.widgets.underConstrution ? (
        <UnderConstruction />
      ) : data.widgets.siteDown ? (
        <SiteDown />
      ) : (
        <div>
          <slot />
        </div>
      )
    }

    <!-- <AccessibilityPanel client:only="react" /> -->

    <script type="module">
      window.addEventListener("load", () => {
        if (
          document.querySelector("review-widget") &&
          !customElements.get("review-widget")
        ) {
          import("https://cdn.jsdelivr.net/gh/InspiredDevops/inspired-components/review-widget.js")
            .then(() => console.log("Review widget cargado"))
            .catch((e) => console.warn("Error al cargar review-widget:", e));
        }
      });
    </script>
    <script
      src="https://cdn.jsdelivr.net/gh/Andres179012/CDN/stories-v2-cdn.js"
      type="module"
      defer></script>
    <script>
      if (document.querySelector('[class*="fa-"]')) {
        const fa = document.createElement("link");
        fa.rel = "stylesheet";
        fa.href =
          "https://cdn.jsdelivr.net/gh/yader316/cdn-font-pro@main/fontawesome-pro-6.5.2-web/css/all.min.css";
        fa.crossOrigin = "anonymous";
        fa.referrerPolicy = "no-referrer";
        document.head.appendChild(fa);
      }
    </script>
    <script
      type="text/javascript"
      src="https://cdn.jsdelivr.net/gh/CodexRob/emailcdn@main/index-06e7f5fd.js"
      defer></script>
    <script
      src="https://static.elfsight.com/platform/platform.js"
      data-use-service-core
      defer></script>
  </body>
</html>
