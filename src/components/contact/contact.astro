---
import type { RootObject } from "../../interfaces/dbData";
import Animated from "../animaciones/Animation";
interface Props {
    data: RootObject;
}

const { data } = Astro.props;
---

<section class="relative w-full py-16 lg:py-24">
    <div class="container mx-auto px-6 lg:px-12">
        {/* Info Cards Grid */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-20">
            {/* Phone Card */}
            <Animated variant="fade-up" duration="duration-700" client:load>
                <div
                    class="group p-10 rounded-[3rem] bg-slate-50 border border-slate-100 hover:bg-white hover:shadow-2xl hover:shadow-slate-200 transition-all duration-500 text-center h-full"
                >
                    <div
                        class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center text-primary mx-auto mb-8 group-hover:bg-primary group-hover:text-white transition-all shadow-lg shadow-primary/10"
                    >
                        <i class="fas fa-phone text-2xl"></i>
                    </div>
                    <p
                        class="text-slate-400 font-black text-[10px] uppercase tracking-[0.2em] mb-4"
                    >
                        Call Us Now
                    </p>
                    <div class="flex flex-col gap-2">
                        {
                            data.dataGeneral?.phones?.map((item) => (
                                <a
                                    href={`tel:+1${item.number}`}
                                    class="text-slate-900 font-black text-xl hover:text-primary transition-colors"
                                >
                                    {item.title && (
                                        <span class="text-slate-500 text-xs font-bold">
                                            {" "}
                                            ({item.title})
                                        </span>
                                    )}
                                    <br />
                                    {item.number}
                                </a>
                            ))
                        }
                    </div>
                </div>
            </Animated>

            {/* Location Card */}
            <Animated
                variant="fade-up"
                duration="duration-700"
                delay="delay-200"
                client:load
            >
                <div
                    class="group p-10 rounded-[3rem] bg-slate-50 border border-slate-100 hover:bg-white hover:shadow-2xl hover:shadow-slate-200 transition-all duration-500 text-center h-full"
                >
                    <div
                        class="w-16 h-16 rounded-2xl bg-secondary/10 flex items-center justify-center text-secondary mx-auto mb-8 group-hover:bg-secondary group-hover:text-white transition-all shadow-lg shadow-secondary/10"
                    >
                        <i class="fas fa-map-marker-alt text-2xl"></i>
                    </div>
                    <p
                        class="text-slate-400 font-black text-[10px] uppercase tracking-[0.2em] mb-4"
                    >
                        Location
                    </p>
                    <div class="flex flex-col gap-2">
                        {
                            data.dataGeneral?.location
                                .slice(0, 1)
                                .map((item) => (
                                    <span class="text-slate-900 font-black text-xl">
                                        {item.city}
                                    </span>
                                ))
                        }
                    </div>
                </div>
            </Animated>

            {/* Opening Hours Card */}
            <Animated
                variant="fade-up"
                duration="duration-700"
                delay="delay-400"
                client:load
            >
                <div
                    class="group p-10 rounded-[3rem] bg-slate-50 border border-slate-100 hover:bg-white hover:shadow-2xl hover:shadow-slate-200 transition-all duration-500 text-center h-full"
                >
                    <div
                        class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center text-primary mx-auto mb-8 group-hover:bg-primary group-hover:text-white transition-all shadow-lg shadow-primary/10"
                    >
                        <i class="fas fa-clock text-2xl"></i>
                    </div>
                    <p
                        class="text-slate-400 font-black text-[10px] uppercase tracking-[0.2em] mb-4"
                    >
                        Working Hours
                    </p>
                    <div class="flex flex-col gap-2">
                        {
                            data.dataGeneral?.openingHours.map((item) => (
                                <div class="flex flex-col leading-tight">
                                    <span class="text-slate-900 font-black text-lg">
                                        {item.hours}
                                    </span>
                                    <span class="text-slate-500 text-xs font-bold">
                                        {item.days}
                                    </span>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </Animated>

            {/* Email Card */}
            <Animated
                variant="fade-up"
                duration="duration-700"
                delay="delay-500"
                client:load
            >
                <div
                    class="group p-10 rounded-[3rem] bg-slate-50 border border-slate-100 hover:bg-white hover:shadow-2xl hover:shadow-slate-200 transition-all duration-500 text-center h-full"
                >
                    <div
                        class="w-16 h-16 rounded-2xl bg-secondary/10 flex items-center justify-center text-secondary mx-auto mb-8 group-hover:bg-secondary group-hover:text-white transition-all shadow-lg shadow-secondary/10"
                    >
                        <i class="fas fa-envelope text-2xl"></i>
                    </div>
                    <p
                        class="text-slate-400 font-black text-[10px] uppercase tracking-[0.2em] mb-4"
                    >
                        Email Us
                    </p>
                    <div class="flex flex-col gap-2">
                        {
                            data.dataGeneral?.emails?.map((item) => (
                                <a
                                    href={`mailto:${item.email}`}
                                    class="text-slate-900 font-black text-sm break-all hover:text-secondary transition-colors"
                                >
                                    {item.email}
                                </a>
                            ))
                        }
                    </div>
                </div>
            </Animated>
        </div>

        {/* Cinematic Call to Action Banner */}
        <Animated variant="fade-up" duration="duration-1000" client:load>
            <div
                class="relative w-full min-h-[400px] rounded-[4rem] overflow-hidden shadow-2xl group/banner"
            >
                <img
                    src={data?.gallery[0]}
                    alt="Work Showcase"
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover/banner:scale-110"
                />
                <div
                    class="absolute inset-0 bg-slate-950/60 backdrop-blur-[2px]"
                >
                </div>
                <div
                    class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/40"
                >
                </div>

                <div
                    class="relative z-10 h-full flex flex-col justify-center items-center text-center p-12 lg:p-24 min-h-[400px]"
                >
                    <h3
                        class="text-3xl md:text-5xl lg:text-6xl font-black text-white italic uppercase tracking-tighter mb-10 max-w-4xl"
                    >
                        {data.slogan[4]}
                    </h3>
                    <a
                        href={`tel:+1${data.dataGeneral?.phones?.[0].number}`}
                        class="group/btn relative px-12 py-5 rounded-full bg-primary text-white font-black text-xs uppercase tracking-[0.3em] overflow-hidden transition-all shadow-2xl shadow-primary/40 hover:scale-105"
                    >
                        <span class="relative z-10"
                            >Get Your Free Quote Now</span
                        >
                        <div
                            class="absolute inset-0 bg-white/20 translate-y-full group-hover/btn:translate-y-0 transition-transform duration-300"
                        >
                        </div>
                    </a>
                </div>
            </div>
        </Animated>
    </div>
</section>
