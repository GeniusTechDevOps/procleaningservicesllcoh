---
import FormatText from "../../../hooks/FormatText";
import type { RootObject, SectionsHomeAbout } from "../../../interfaces/dbData";
import { getAppDataDirect } from "../../../utils/api";

// Realiza la llamada a la API (o carga datos locales si API_URL está vacía)
const data: RootObject = await getAppDataDirect();
//filtrar para obtener la section de about
const aboutSection = data?.sectionsHomeAbout.filter(
    (section: SectionsHomeAbout) => section.section === "about",
);
const year = new Date().getFullYear();
---

<footer
    class="relative w-full pt-24 pb-12 overflow-hidden bg-slate-950 text-white"
>
    {/* Decorative background accent */}
    <div
        class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-primary/50 to-transparent"
    >
    </div>

    <div class="container mx-auto px-6 lg:px-12 relative z-10">
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16 mb-20"
        >
            {/* Brand & Slogan Column */}
            <div class="flex flex-col space-y-8">
                <img
                    src={data.logos.primary}
                    alt={data.name}
                    class="w-48 object-contain"
                />
                <p
                    class="text-slate-400 text-sm leading-relaxed max-w-xs italic"
                >
                    "{data.slogan[1]}, 
                    {data.slogan[2]}"
                </p>
                <div class="flex gap-4">
                    {
                        data.redesSociales.map((item) => (
                            <a
                                href={item.link}
                                target="_blank"
                                aria-label={item.name}
                                class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white hover:bg-primary transition-all duration-300"
                            >
                                <i class={`fa-brands fa-${item.icon}`} />
                            </a>
                        ))
                    }
                </div>
            </div>

            {/* Navigation Column */}
            <div>
                <h4
                    class="text-white font-black text-lg mb-8 uppercase tracking-widest flex items-center gap-3"
                >
                    <span class="w-8 h-[2px] bg-primary"></span>
                    Navigation
                </h4>
                <ul class="space-y-4">
                    {
                        ["Home", "About", "Portfolio", "Contact"].map(
                            (item) => (
                                <li>
                                    <a
                                        href={
                                            item === "Home"
                                                ? "/"
                                                : `/${item.toLowerCase()}`
                                        }
                                        class="text-slate-400 hover:text-primary transition-colors flex items-center gap-2 group"
                                    >
                                        <i class="fas fa-chevron-right text-[10px] opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0" />
                                        {item}
                                    </a>
                                </li>
                            ),
                        )
                    }
                </ul>
            </div>

            {/* Services Column */}
            <div>
                <h4
                    class="text-white font-black text-lg mb-8 uppercase tracking-widest flex items-center gap-3"
                >
                    <span class="w-8 h-[2px] bg-secondary"></span>
                    Services
                </h4>
                <div class="grid grid-cols-1 gap-4">
                    {
                        data.services.slice(0, 6).map((service) => (
                            <a
                                href={
                                    data.widgets.landingServices
                                        ? `/services/${FormatText(service.title)}`
                                        : "/services"
                                }
                                class="text-slate-400 hover:text-secondary transition-colors text-sm flex items-center gap-2 group"
                            >
                                <span class="w-1.5 h-1.5 rounded-full bg-secondary/30 group-hover:bg-secondary transition-colors" />
                                {service.title}
                            </a>
                        ))
                    }
                </div>
            </div>

            {/* Contact Column */}
            <div>
                <h4
                    class="text-white font-black text-lg mb-8 uppercase tracking-widest flex items-center gap-3"
                >
                    <span class="w-8 h-[2px] bg-primary"></span>
                    Contact Us
                </h4>
                <div class="space-y-6">
                    {
                        data.dataGeneral.phones.map((phone) => (
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-primary shrink-0">
                                    <i class="fas fa-phone text-sm" />
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-[10px] font-black uppercase tracking-widest text-slate-500 mb-1">
                                        {phone.title}
                                    </span>
                                    <a
                                        href={`tel:+1${phone.number}`}
                                        class="text-slate-200 hover:text-primary transition-colors font-bold"
                                    >
                                        {phone.number}
                                    </a>
                                </div>
                            </div>
                        ))
                    }
                    {
                        data.dataGeneral.emails.map((email) => (
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-primary shrink-0">
                                    <i class="fas fa-envelope text-sm" />
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-[10px] font-black uppercase tracking-widest text-slate-500 mb-1">
                                        Email Us
                                    </span>
                                    <a
                                        href={`mailto:${email.email}`}
                                        class="text-slate-200 hover:text-primary transition-colors font-bold break-all"
                                    >
                                        {email.email}
                                    </a>
                                </div>
                            </div>
                        ))
                    }
                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-primary shrink-0"
                        >
                            <i class="fas fa-location-dot text-sm"></i>
                        </div>
                        <div class="flex flex-col">
                            <span
                                class="text-[10px] font-black uppercase tracking-widest text-slate-500 mb-1"
                                >Location</span
                            >
                            <p class="text-slate-200 font-bold">
                                Serving {data.dataGeneral.location[0].city} & Surroundings
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {/* Bottom Bar */}
        <div
            class="pt-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-8 text-center md:text-left"
        >
            <div class="flex flex-col gap-2">
                <p class="text-slate-500 text-xs">
                    © {year}
                    {data.name}. All rights reserved.
                </p>
                <p
                    class="text-[10px] text-slate-600 font-bold uppercase tracking-[0.2em]"
                >
                    Professional Cleaning Services
                </p>
            </div>

            
        </div>
    </div>
</footer>
