---
import type { RootObject } from "../../interfaces/dbData";
import { getAppDataDirect } from "../../utils/api";

interface Props {
  image: string;
  title?: string;
}

const { image, title } = Astro.props;

const data: RootObject = await getAppDataDirect();
---

<section class="relative w-full overflow-hidden bg-slate-900">
  {/* Cinematic Background */}
  <div class="absolute inset-0 z-0">
    <img src={image} alt={title} class="w-full h-full object-cover" />
    {/* Sophisticated Overlays */}
    <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-[2px]"></div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-transparent to-slate-950/80"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-r from-primary/20 via-transparent to-secondary/20 opacity-40"
    >
    </div>
  </div>

  {/* Content Container */}
  <div
    class="relative z-10 container mx-auto px-6 lg:px-12 pt-48 pb-32 lg:pt-32 lg:pb-48"
  >
    <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
      {/* Decorative Brand Accent */}
      <div class="mb-8 inline-flex items-center gap-4 opacity-80">
        <div class="h-px lg:w-12 bg-white/30"></div>
        <img src={data.logos.primary} alt={data.name} class="h-52" />
        <div class="h-px lg:w-12 bg-white/30"></div>
      </div>

      {/* Main Title */}
      <h1
        class="text-5xl md:text-7xl lg:text-8xl font-black text-white leading-none tracking-tighter mb-12 uppercase italic"
      >
        {title}
      </h1>

      {/* Glassmorphic Breadcrumbs */}
      <nav
        class="inline-flex items-center p-2 rounded-2xl bg-white/5 backdrop-blur-md border border-white/10 shadow-2xl"
      >
        <div class="flex items-center gap-3 px-4 py-2">
          <a
            href="/"
            class="group flex items-center gap-2 text-white/70 hover:text-white transition-all duration-300"
          >
            <i
              class="fa-solid fa-house text-xs group-hover:scale-110 transition-transform"
            ></i>
            <span class="text-xs font-black uppercase tracking-widest"
              >Home</span
            >
          </a>

          <div class="w-1 h-1 rounded-full bg-white/20"></div>

          <div class="flex items-center gap-2 text-primary">
            <i class="fa-solid fa-burst text-xs"></i>
            <span class="text-xs font-black uppercase tracking-widest"
              >{title}</span
            >
          </div>
        </div>
      </nav>
    </div>
  </div>

  {/* Bottom Decorative Edge */}
  <div
    class="absolute bottom-0 left-0 w-full h-24 bg-gradient-to-t from-white to-transparent z-20"
  >
  </div>
</section>

<style>
  @keyframes subtle-zoom {
    from {
      transform: scale(1.05);
    }
    to {
      transform: scale(1.15);
    }
  }
</style>
